@main
function test_a_simple_while_loop() int {
    let i = 0
    while ($i < 10) {
        $i = ($i + 1)   // increment
        std::println("doing simple loop, i=$i")
    }
    return 0
}

function test_some_c_function() noret {
    let i = 0
    while ($i < 10) {
        $i = ($i + 1)   // increment
        // Use libc printf
        c::printf("doing simple loop, i=%d\n", $i)
    }
}