#!/usr/bin/env alsh

@stdlib
@main

function main() int {
    println("=== Test bare len() in chain ===")

    # Using bare len() instead of std::len()
    let len_result = chain {
        "hello world"
        std::split(@, " ")
        len()
    }
    println("len_result = $len_result")

    return 0
}
