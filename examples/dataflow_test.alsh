#!/usr/bin/env alsh

# Dataflow regression test for ALSH constructs:
# - shell pipes (`|`)
# - ALSH pipelines (`->`)
# - value chains (`chain {}`)

@stdlib

@main
function main() int {
    println("=== ALSH dataflow regression test ===")

    println("--- shell pipe test ---")
    # count words in string
    let word_count = chain {
        "one two three"
        std::split(@, " ")
        std::len()
    }
    println("word count = $word_count")

    println("--- ALSH stream pipeline test ---")
    let upper = "one two three" -> std::upper()
    println("upper = $upper")

    println("--- ALSH stream pipeline with explicit binding ---")
    let pipeline = "one two three" -> std::split(@, " ") -> std::len()
    println("pipeline result = $pipeline")

    println("--- value chain implicit single-arg binding ---")
    let words = chain {
        "hello world"
        std::split(@, " ")
        len()
    }
    println("word count = $words")

    println("--- value chain explicit @ binding ---")
    let found = chain {
        "goodbye world"
        std::contains(@, "world")
    }
    println("contains world = $found")

    println("--- value chain literal to function ---")
    let trimmed = chain {
        "   spaced out   "
        std::trim()
    }
    println("trimmed = '$trimmed'")

    return 0
}
