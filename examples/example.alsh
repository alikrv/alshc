#!/usr/local/bin/alsh

@stdlib
@main
function an_example() int {

    let myvar = "Hello, ALSH!"
    println($myvar)

    loop count 10 {
        println("Loop iteration")
    }

    println("Hello, world!")
    c::puts("Hello from C!")


    let message = "hey"
    c::puts($message)
    println($message)
    println($message)

    return 0
}