#!/usr/local/bin/alsh

@stdlib
@define API_URL https://api.example.com
@include "utils.alsh"
@include "Ctest.alsh"

@main
function start() int { // notice how its not called main? well its the main function anyway

    println("Starting ALSH demo...")

    let name = "ArchUser"
    let greeting = "$name, welcome to ALSH"

    println("$greeting")

    let x = (3 + 4)
    let y = ($x * 2)

    println("x=$x")
    println("y=$y")

    c::puts("Hello from C world")

    # Get kernel info using C call
    let kernel = c::system("uname -r")
    println("kernel=$kernel")

    # --- scope demonstration ---
    let outer = "outside"

    let scoped = {
        println("inside block, outer=$outer")

        let inner = "inside"

        println("inner=$inner")
    }

    # --- shadowing ---
    let value = 10

    let shadow_test = {
        let value = 20
        println("inner value=$value")
    }

    println("outer value=$value")

    # --- loops ---
    let counter = 0
    loop {
        println("loop iteration $counter")
        let counter = ($counter + 1)

        if ($counter == 3) {
            break
        }
    }

    loop count 3 {
        println("count loop iteration")
    }

    let ticks = 0
    loop interval 1 {
        println("tick $ticks")
        let ticks = ($ticks + 1)

        if ($ticks == 2) {
            break
        }
    }

    let i = 0
    while ($i < 5) {
        println("while iteration $i")
        let i = ($i + 1)

        if ($i == 3) {
            break
        }
    }



    # --- arrays ---
    let arr = [1, 2, 3]

    foreach item in arr {
        println("item=$item")
    }

    foreach word in ["one", "two", "three"] {
        println("word=$word")
    }

    # --- C-style loop ---
    for (let j = 0, $j < 3, let j = ($j + 1)) {
        println("j=$j")
    }

    # --- function usage ---
    let sum = add(5, 7)
    println("sum=$sum")

    # --- block return + scope ---
    let summary = {
        if ($x > $y) {
            let msg = "x bigger"
            println($msg)
        } else {
            let msg = "y bigger"
            println($msg)
        }

        # println($msg)   # ❌ not guaranteed (different branches)
    }

    println("summary=$summary")

    # --- try/catch ---

    try {
        # In typed language, replace shell commands with proper API calls
        let data = "sample data"
        println("data=$data")
    } catch {
        println("Failed to fetch data")
    }

    foreach arg in args {
        println("Argument: $arg")
    }

    get_data(2, API_URL)

    let test_var = "test"
    println("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@")
    get_data(1, $test_var)

    do_some_c_testing()

    return 0
}

function add(a, b) int {
    let result = ($a + $b)
    return $result
}

function get_data(interval, url) noret {

    loop count 3 {

        try {
            # In a typed language, replace shell commands with proper API calls
            let data = "sample api response"
            let time = "12:34:56"

            let output = {
                println($data)
                println("fetched at $time")
            }

            println($output)

        } catch {
            println("request failed")
            break
        }

        // Sleep using C function or standard library
        c::sleep(interval)
    }
}