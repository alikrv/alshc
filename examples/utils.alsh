@stdlib
@define PI 3.14159

// test various features

function test_variables_and_scopes() noret {
    let x = 10
    println("x: $x")

    let block = {
        println("inside block, x: $x")
        let y = 20
        println("y: $y")
    }

    // y is not accessible here, should error if uncommented
    // println("y outside block: $y")
}

function test_looops() noret {
    let count = 0
    loop {
        println("Loop iteration: $count")
        let count = ($count + 1)
        if ($count >= 5) {
            break
        }
    }

    loop count 3 {
        println("Counted loop iteration")
    }

    let ticks = 0
    loop interval 1 {
        $ticks = ($ticks + 1) // need a variable to die
        println("Interval loop tick: $ticks")
        if ($ticks >= 5) {
            break
        }
    }
}

function test_looops() noret {

    let i = 0
    for (, $i < 5, $i = ($i + 1)) { // init left empty as i declared it one line above
        println("C-style For loop iteration: $i")
    } // C style for

    while ($i < 10) {
        println("While loop iteration: $i")
        let i = ($i + 1)
    } // while loop

    foreach item in [1, 2, 3] {
        println("Foreach loop item: $item")
    } // iterator style for
}

function assignment_test() noret {
    let a = 5
    println("a: $a")

    $a = 10
    println("a after reassignment: $a")

    let b = $a
    println("b (assigned from a): $b")

@main
function test_stuff() int {
    //test_variables_and_scopes()
    //test_looops()
    test_lops()
    //assignment_test()
    return 0
}