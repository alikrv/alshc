function test_new_stuff() noret {
    test_structs()
    test_enums()
    test_scan()
    test_switch()
}

struct person {
    age: int
    name: str
    height: float
}

enum bread_id {
    brioche
    fougasse
    baguette
    croissant
}

function french_function() noret {
    println("french_function")
}

function other_function() noret {
    println("other_function")
}

function snack_function() noret {
    println("snack_function")
}

function test_structs() noret {
    println("--- test structs ---")
    let alice = person { age: 28 name: "Alice" height: 1.70 }
    println("name: $alice.name")
    println("age: $alice.age")
    println("height: $alice.height")

    let older = person { age: ($alice.age + 5) name: $alice.name height: $alice.height }
    println("older.age: $older.age")
}

function test_enums() noret {
    println("--- test enums ---")
    let loaf = bread_id.croissant
    println("chosen bread: $loaf")

    if ($loaf == bread_id.croissant) {
        println("croissant match")
    } else {
        println("other bread")
    }
}

function test_scan() noret {
    println("--- test scan ---")
    let current_bread = bread_id.fougasse

    scan of bread_id {
        brioche: french_function()
        baguette: french_function()
        fougasse: other_function()
        croissant: snack_function()
    }
}

function test_switch() noret {
    println("--- test switch ---")
    let current_bread = bread_id.croissant

    switch on current_bread {
        brioche: french_function()
        baguette: french_function()
        fougasse: other_function()
        croissant: snack_function()
        default: other_function()
    }
}

@main
function test_main() int {
    //
    return 0
}